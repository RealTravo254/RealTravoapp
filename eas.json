{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" }
    },
    "preview-clean": {
      "extends": "preview",
      "cache": { "disabled": true }
    },
    "simulator": {
      "distribution": "internal",
      "environment": "preview",
      "ios": { "simulator": true }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "production": {}
  }
}