{
  "expo": {
    "name": "RealTravo",
    "slug": "realtravo",
    "version": "1.0.0",
    "scheme": "travelapp",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.realtravo.app",
      "config": {
        "googleMapsApiKey": "AIzaSyDDEgpli_tVkudExO-skDxNOOXuvwHonj0"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Scan booking QR codes",
        "NSLocationWhenInUseUsageDescription": "Show places near you",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.realtravo.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scan booking QR codes",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Show places near you" }
      ],
      "expo-localization",
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "supabaseUrl": "https://whtyrqbmbgyospyrlznx.supabase.co",
      "supabaseAnonKey": "sb_publishable_u1ODuKbdMUAjBYzxAnxNvg_DOc0qDcS",
      "googleKey": "YOUR_GOOGLE_PLACES_API_KEY",
      "googleWebClientId": "YOUR_GOOGLE_WEB_CLIENT_ID"
    }
  }
}
