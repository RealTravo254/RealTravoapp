{
  "expo": {
    "name": "RealTravo",
    "slug": "realtravo",
    "version": "1.0.0",
    "scheme": "travelapp",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.realtravo.app",
      "config": {
        "googleMapsApiKey": "AIzaSyDDEgpli_5ttueueeh-skDxNOOvwHonj0"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Scan booking QR codes",
        "NSLocationWhenInUseUsageDescription": "Show places near you",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.realtravo.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-keep class androidx.work.** { *; }\n-keep class * extends androidx.room.RoomDatabase { *; }"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#1B4432",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan booking QR codes",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show places near you"
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://whtyrqbmbgyospyrlznx.supabase.co",
      "supabaseAnonKey": "sb_publishable_u1ODuKbdMUAjBYzxAnxNvg_DOc0qDcS",
      "eas": {
        "projectId": "03817903-db99-4393-a47e-f5308c1262a3"
      }
    }
  }
}